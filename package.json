{
  "name": "tauri-plugin-sentry-api",
  "version": "0.8.0",
  "description": "Tauri Plugin for Sentry",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "yarn build:ts && yarn build:rust",
    "build:ts": "tsc --project ./js/tsconfig.json && rollup -c ./js/rollup.config.mjs",
    "build:rust": "cargo build",
    "example": "cd examples/basic-app && yarn && yarn tauri dev",
    "e2e": "yarn e2e:build && yarn e2e:test",
    "e2e:build": "rollup -c ./test/e2e/app/rollup.config.mjs && cargo build --manifest-path ./test/e2e/app/src-tauri/Cargo.toml",
    "e2e:test": "vitest run --config ./test/e2e/vitest.config.mts",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@sentry/browser": "^10.8.0",
    "@sentry/core": "^10.8.0",
    "rollup": "^4.50.0",
    "@rollup/plugin-terser": "^0.4.4",
    "typescript": "^5.1.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "2.0.0-beta.8",
    "tslib": "^2.6.0"
  }
}